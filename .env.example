# Copy to .env locally; never put credentials in chat or source control.
PORT=4180
HOST=127.0.0.1
DB_PATH=./data/paper.sqlite
BOT_HANDLE=StrikeAGentt
BOT_USER_ID=
# Needed for CRC and verification of incoming X webhooks.
X_CLIENT_SECRET=
# Optional legacy webhook signing secret.
X_CONSUMER_SECRET=
# User-context OAuth 2 access token: tweet.read users.read tweet.write
X_USER_ACCESS_TOKEN=
# App-only bearer token for webhook registration (not the signing secret).
X_APP_BEARER_TOKEN=
# Defaults to draft. Change only after X access and automated-reply eligibility are confirmed.
X_REPLY_MODE=draft
X_AUTOMATION_APPROVED=false
# Protects local test ingestion and operator views. Use a long random value.
ADMIN_TOKEN=
STRIKE_BASE_URL=https://api.strikefinance.org
SYMBOLS=BTC-USD,ETH-USD,SOL-USD,ADA-USD
STARTING_BALANCE=10000
# Simulation assumptions, not Strike's actual execution fees.
FEE_BPS=5
SLIPPAGE_BPS=5
MAX_LEVERAGE=5
MAX_OPEN_POSITIONS=5
PRICE_MAX_AGE_MS=15000
POLL_MS=5000
